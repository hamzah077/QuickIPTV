<?xml version="1.0" encoding="utf-8"?>
<!-- رجوع: الصفحة تختفي بهدوء مع تصغير خفيف -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="170" android:interpolator="@android:anim/accelerate_interpolator" android:zAdjustment="top">
    <alpha android:fromAlpha="1" android:toAlpha="0" />
    <scale android:fromXScale="1" android:toXScale="0.96" android:fromYScale="1" android:toYScale="0.96"
        android:pivotX="50%" android:pivotY="50%" />
</set>
