<?xml version="1.0" encoding="utf-8"?>
<!-- فتح صفحة: تظهر بهدوء مع تكبير خفيف (أقل من 200ms = سلس حتى على الأجهزة الضعيفة) -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="190" android:interpolator="@android:anim/decelerate_interpolator" android:zAdjustment="top">
    <alpha android:fromAlpha="0" android:toAlpha="1" />
    <scale android:fromXScale="0.96" android:toXScale="1" android:fromYScale="0.96" android:toYScale="1"
        android:pivotX="50%" android:pivotY="50%" />
</set>
