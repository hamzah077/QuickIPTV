<resources>
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/bg</item>
        <item name="android:colorPrimaryDark">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:windowAnimationStyle">@style/QuickAnim</item>
    </style>
    <!-- حركة خفيفة لفتح الصفحات والرجوع -->
    <style name="QuickAnim" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/qi_open_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/qi_open_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/qi_close_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/qi_close_exit</item>
    </style>
    <!-- صفحة الفيلم/المسلسل: شفافة من ورا (الصفحة نفسها لها خلفية) — لما تسحبها لتحت تبان الصفحة الحقيقية اللي تحتها (زي يوتيوب) -->
    <style name="DetailsTheme" parent="AppTheme">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
    <style name="PlayerTheme" parent="AppTheme">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
    </style>
    <!-- ليكود جلاس (التلفزيون): النوافذ المنبثقة لوحة زجاج كثيف، والصف المحدد زجاج أوضح بحافة بيضاء -->
    <style name="GlassDialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/glass_dialog_bg</item>
        <item name="android:colorAccent">#FFFFFFFF</item>
        <item name="android:textColorPrimary">#FFFFFFFF</item>
        <item name="android:textColorSecondary">#FFC4C8D0</item>
        <item name="android:backgroundDimAmount">0.55</item>
        <item name="android:listChoiceBackgroundIndicator">@drawable/glass_dialog_item</item>
        <item name="android:selectableItemBackground">@drawable/glass_dialog_item</item>
        <item name="android:listViewStyle">@style/GlassDialogList</item>
    </style>
    <style name="GlassDialogList" parent="android:Widget.Material.ListView">
        <item name="android:listSelector">@drawable/glass_dialog_item</item>
        <item name="android:drawSelectorOnTop">false</item>
        <item name="android:divider">@null</item>
    </style>
</resources>
