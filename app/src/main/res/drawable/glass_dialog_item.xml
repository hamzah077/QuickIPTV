<?xml version="1.0" encoding="utf-8"?>
<!-- صف داخل النافذة: محدد/مضغوط = زجاج أوضح بحافة بيضاء (الكتابة تبقى بيضاء وواضحة) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:enterFadeDuration="110" android:exitFadeDuration="110">
    <item android:state_pressed="true">
        <inset android:insetLeft="10dp" android:insetRight="10dp" android:insetTop="2dp" android:insetBottom="2dp">
            <shape><solid android:color="#2EFFFFFF" /><corners android:radius="22dp" /></shape>
        </inset>
    </item>
    <item android:state_focused="true">
        <inset android:insetLeft="10dp" android:insetRight="10dp" android:insetTop="2dp" android:insetBottom="2dp">
            <shape><solid android:color="#47FFFFFF" /><corners android:radius="22dp" /></shape>
        </inset>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
